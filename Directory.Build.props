<Project>
  <!--
    Shared build settings for every project in the solution — analyzers on, warnings treated as
    errors, so a code-quality regression fails the build (and CI) instead of sitting unnoticed.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
