<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">Home</MudNavLink>
    <MudNavLink Href="/resources" Icon="@Icons.Material.Filled.MeetingRoom">Resources</MudNavLink>

    <AuthorizeView>
        <Authorized>
            <MudNavLink Href="/my-bookings" Icon="@Icons.Material.Filled.EventNote">My bookings</MudNavLink>
        </Authorized>
    </AuthorizeView>

    <AuthorizeView Roles="Admin">
        <Authorized>
            <MudNavGroup Title="Admin" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="true">
                <MudNavLink Href="/admin/resources" Icon="@Icons.Material.Filled.Edit">Manage resources</MudNavLink>
                <MudNavLink Href="/admin/bookings" Icon="@Icons.Material.Filled.FactCheck">All bookings</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>
</MudNavMenu>
