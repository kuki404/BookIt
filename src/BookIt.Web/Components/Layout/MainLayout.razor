@inherits LayoutComponentBase
@inject AuthSession Session
@inject ThemeService ThemeService
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<MudThemeProvider Theme="BookItTheme.Theme" @bind-IsDarkMode="isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a href="#main-content" class="skip-link">Skip to main content</a>

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                        OnClick="@ToggleDrawer" aria-label="Toggle navigation menu" />
        <MudText Typo="Typo.h6" Class="ml-2">BookIt</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                        Color="Color.Inherit" OnClick="ToggleThemeAsync"
                        aria-label="@(isDarkMode ? "Switch to light theme" : "Switch to dark theme")" />
        <AuthorizeView>
            <Authorized>
                <MudText Class="mx-3" Typo="Typo.body2">@context.User.Identity!.Name</MudText>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick="LogoutAsync">Log out</MudButton>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/login">Log in</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/register">Register</MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent id="main-content">
        <MudContainer MaxWidth="MaxWidth.Large" Class="my-6">
            <ErrorBoundary @ref="errorBoundary">
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <MudAlert Severity="Severity.Error" Class="my-4">
                        Something went wrong rendering this page.
                        <MudButton Variant="Variant.Text" OnClick="@(() => errorBoundary?.Recover())">Try again</MudButton>
                    </MudAlert>
                </ErrorContent>
            </ErrorBoundary>
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool drawerOpen = true;
    private bool isDarkMode;
    private ErrorBoundary? errorBoundary;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        // Order matters: restore the session first so the very first real render already reflects
        // "still logged in" instead of flashing a logged-out state after a refresh.
        await Session.RestoreAsync();

        var systemPrefersDark = await JsRuntime.InvokeAsync<bool>("getSystemDarkMode");
        await ThemeService.InitializeAsync(systemPrefersDark);
        isDarkMode = ThemeService.IsDarkMode;
        StateHasChanged();
    }

    private void ToggleDrawer() => drawerOpen = !drawerOpen;

    private async Task ToggleThemeAsync()
    {
        isDarkMode = !isDarkMode;
        await ThemeService.SetAsync(isDarkMode);
    }

    private async Task LogoutAsync()
    {
        await Session.ClearAsync();
        Navigation.NavigateTo("/", forceLoad: false);
    }
}
