@page "/login"
@inject BookItApiClient Api
@inject NavigationManager Navigation

<PageTitle>Log in – BookIt</PageTitle>
<HeadContent>
    <meta name="description" content="Log in to BookIt to reserve rooms, equipment and services." />
    <meta name="robots" content="noindex" />
</HeadContent>

<MudText Typo="Typo.h4" Class="mb-4">Log in</MudText>

<MudPaper Class="pa-6" MaxWidth="420px" Elevation="1">
    <MudTextField T="string" Label="Email" @bind-Value="model.Email" Required="true" InputType="InputType.Email" Class="mb-3" />
    <MudTextField T="string" Label="Password" @bind-Value="model.Password" Required="true" InputType="InputType.Password" Class="mb-3" />

    @if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="SubmitAsync" Disabled="submitting">
        @if (submitting)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
        }
        Log in
    </MudButton>

    <MudText Typo="Typo.body2" Class="mt-3">
        No account yet? <MudLink Href="/register">Register</MudLink>
    </MudText>

    <MudDivider Class="my-4" />

    <MudText Typo="Typo.body2" Class="mb-2">Or try it instantly with seeded demo data — no typing required:</MudText>
    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => DemoLoginAsync("admin@bookit.local", "Admin123!"))" Disabled="submitting">
            Demo Admin
        </MudButton>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="@(() => DemoLoginAsync("customer@bookit.local", "Customer123!"))" Disabled="submitting">
            Demo Customer
        </MudButton>
    </div>
</MudPaper>

@code {
    private readonly FormModel model = new();
    private string? errorMessage;
    private bool submitting;

    private Task SubmitAsync() => LoginAsync(model.Email, model.Password);

    private Task DemoLoginAsync(string email, string password) => LoginAsync(email, password);

    private async Task LoginAsync(string email, string password)
    {
        errorMessage = null;
        submitting = true;
        try
        {
            var (success, error) = await Api.LoginAsync(new LoginRequest(email, password));
            if (success)
            {
                Navigation.NavigateTo("/resources");
            }
            else
            {
                errorMessage = error;
            }
        }
        finally
        {
            submitting = false;
        }
    }

    private class FormModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
