@page "/register"
@inject BookItApiClient Api
@inject NavigationManager Navigation

<PageTitle>Register – BookIt</PageTitle>
<HeadContent>
    <meta name="description" content="Create a free BookIt account to reserve rooms, equipment and services." />
    <meta name="robots" content="noindex" />
</HeadContent>

<MudText Typo="Typo.h4" Class="mb-4">Create an account</MudText>

<MudPaper Class="pa-6" MaxWidth="420px" Elevation="1">
    <MudTextField T="string" Label="Display name" @bind-Value="model.DisplayName" Required="true" Class="mb-3" />
    <MudTextField T="string" Label="Email" @bind-Value="model.Email" Required="true" InputType="InputType.Email" Class="mb-3" />
    <MudTextField T="string" Label="Password" @bind-Value="model.Password" Required="true" InputType="InputType.Password"
                   HelperText="At least 8 characters, with an uppercase letter, a lowercase letter, and a digit." Class="mb-3" />

    @if (errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
    }

    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" OnClick="SubmitAsync" Disabled="submitting">
        Register
    </MudButton>

    <MudText Typo="Typo.body2" Class="mt-3">
        Already have an account? <MudLink Href="/login">Log in</MudLink>
    </MudText>
</MudPaper>

@code {
    private readonly FormModel model = new();
    private string? errorMessage;
    private bool submitting;

    private async Task SubmitAsync()
    {
        errorMessage = null;
        submitting = true;
        try
        {
            var (success, error) = await Api.RegisterAsync(new RegisterRequest(model.Email, model.Password, model.DisplayName));
            if (success)
            {
                Navigation.NavigateTo("/resources");
            }
            else
            {
                errorMessage = error;
            }
        }
        finally
        {
            submitting = false;
        }
    }

    private class FormModel
    {
        public string DisplayName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}
