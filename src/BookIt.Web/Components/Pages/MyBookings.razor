@page "/my-bookings"
@attribute [Authorize]
@inject BookItApiClient Api
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>My bookings – BookIt</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<MudText Typo="Typo.h4" Class="mb-4">My bookings</MudText>

@if (bookings is null)
{
    <MudSkeleton Height="40px" Class="mb-2" />
    <MudSkeleton Height="40px" Class="mb-2" />
    <MudSkeleton Height="40px" Class="mb-2" />
}
else if (bookings.Count == 0)
{
    <MudAlert Severity="Severity.Info">
        You have no bookings yet. Head to <MudLink Href="/resources">Resources</MudLink> to book one.
    </MudAlert>
}
else
{
    <MudTable Items="bookings" Hover="true" Elevation="1">
        <HeaderContent>
            <MudTh>Reference</MudTh>
            <MudTh>Resource</MudTh>
            <MudTh>When (UTC)</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Reference">
                <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="@(() => CopyAsync(context.ReferenceCode))">
                    @context.ReferenceCode
                </MudButton>
            </MudTd>
            <MudTd DataLabel="Resource">@context.ResourceName</MudTd>
            <MudTd DataLabel="When">@context.TimeRangeDisplay</MudTd>
            <MudTd DataLabel="Status">
                <MudChip T="string" Color="@context.StatusColor" Size="Size.Small">@context.StatusDisplay</MudChip>
            </MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => ShowDetailsAsync(context))">
                    Details
                </MudButton>
                @if (context.Status is BookingStatus.Pending or BookingStatus.Confirmed)
                {
                    <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text" OnClick="@(() => CancelAsync(context.Id))">
                        Cancel
                    </MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<BookingViewModel>? bookings;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // .Adapt<T>() (Mapster) fills the API DTO into the UI view-model, computing the display-only
    // fields (chip color, formatted time range) registered in MapsterConfig.
    private async Task LoadAsync() => bookings = (await Api.GetMyBookingsAsync())?.Items.Adapt<List<BookingViewModel>>() ?? [];

    private async Task ShowDetailsAsync(BookingViewModel booking)
    {
        var parameters = new DialogParameters<BookingDetailsDialog> { { d => d.Booking, booking } };
        await DialogService.ShowAsync<BookingDetailsDialog>("Booking details", parameters);
    }

    private async Task CancelAsync(Guid id)
    {
        var (booking, error) = await Api.CancelBookingAsync(id, "Cancelled by customer");
        Snackbar.Add(booking is not null ? "Booking cancelled." : error ?? "Cancel failed.",
            booking is not null ? Severity.Success : Severity.Error);
        await LoadAsync();
    }

    private async Task CopyAsync(string text)
    {
        await JsRuntime.InvokeVoidAsync("copyToClipboard", text);
        Snackbar.Add("Reference copied.", Severity.Info);
    }
}
