@page "/resources"
@inject BookItApiClient Api
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Resources – BookIt</PageTitle>
<HeadContent>
    <meta name="description" content="Browse bookable rooms, equipment and services." />
    <link rel="canonical" href="/resources" />
</HeadContent>

<MudText Typo="Typo.h4" Class="mb-4">Resources</MudText>

@if (resources is null)
{
    <MudSkeleton Height="40px" Class="mb-2" />
    <MudSkeleton Height="40px" Class="mb-2" />
    <MudSkeleton Height="40px" Class="mb-2" />
}
else if (resources.Count == 0)
{
    <MudAlert Severity="Severity.Info" Icon="@Icons.Material.Filled.Inbox">
        No resources available yet.
        <AuthorizeView Roles="Admin" Context="authState">
            <Authorized>— add one under <MudLink Href="/admin/resources">Manage resources</MudLink>.</Authorized>
        </AuthorizeView>
    </MudAlert>
}
else
{
    <MudTable Items="resources" Hover="true" Elevation="1">
        <HeaderContent>
            <MudTh>Name</MudTh>
            <MudTh>Type</MudTh>
            <MudTh>Capacity</MudTh>
            <MudTh>Description</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Type"><MudIcon Icon="@context.TypeIcon" Size="Size.Small" Class="mr-1" />@context.TypeDisplay</MudTd>
            <MudTd DataLabel="Capacity">@context.Capacity</MudTd>
            <MudTd DataLabel="Description">@context.Description</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Class="mr-2" Href="@($"/resources/{context.Id}/availability")">
                    Availability
                </MudButton>
                <AuthorizeView Context="authState">
                    <Authorized>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => BookAsync(context))">
                            Book
                        </MudButton>
                    </Authorized>
                    <NotAuthorized>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Href="/login">Log in to book</MudButton>
                    </NotAuthorized>
                </AuthorizeView>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<ResourceViewModel>? resources;

    protected override async Task OnInitializedAsync()
    {
        resources = (await Api.GetResourcesAsync())?.Items.Adapt<List<ResourceViewModel>>() ?? [];
    }

    private async Task BookAsync(ResourceViewModel resource)
    {
        var parameters = new DialogParameters<BookResourceDialog> { { d => d.Resource, resource } };
        var dialog = await DialogService.ShowAsync<BookResourceDialog>($"Book {resource.Name}", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Snackbar.Add("Booking request submitted.", Severity.Success);
        }
    }
}
