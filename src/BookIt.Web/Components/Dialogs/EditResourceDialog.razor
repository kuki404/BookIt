@inject BookItApiClient Api

<MudDialog>
    <DialogContent>
        <MudTextField T="string" Label="Name" @bind-Value="name" Required="true" Class="mb-3" />
        <MudNumericField T="int" Label="Capacity" @bind-Value="capacity" Min="1" Class="mb-3" />
        <MudTextField T="string" Label="Description" @bind-Value="description" Lines="2" Class="mb-3" />

        @if (errorMessage is not null)
        {
            <MudAlert Severity="Severity.Error">@errorMessage</MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SubmitAsync" Disabled="submitting">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ResourceViewModel Resource { get; set; } = default!;

    private string name = string.Empty;
    private int capacity;
    private string? description;
    private string? errorMessage;
    private bool submitting;

    protected override void OnInitialized()
    {
        name = Resource.Name;
        capacity = Resource.Capacity;
        description = Resource.Description;
    }

    private async Task SubmitAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(name))
        {
            errorMessage = "Name is required.";
            return;
        }

        submitting = true;
        try
        {
            var updated = await Api.UpdateResourceAsync(Resource.Id, new UpdateResourceRequest(name, capacity, description));
            if (updated is null)
            {
                errorMessage = "Update failed.";
                return;
            }

            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            submitting = false;
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
