# ==============================================================================================
# Copy this file to ".env" and put your own values in it:   cp .env.example .env
#
# ".env" is listed in .gitignore and is never committed — that is what makes the database and the
# signing key YOURS, not shared with anyone else who clones this repository.
#
# Docker Compose reads ".env" automatically; nothing else needs to be configured to run the whole
# stack with:   docker compose up -d --build
#
# Running the apps locally with `dotnet run` instead of in containers? Those read User Secrets,
# not this file — see "First-time setup" in README.md.
# ==============================================================================================

# Password for the SA account of the local SQL Server container.
#
# SQL Server enforces a password policy and the container will refuse to start if it is not met:
# at least 8 characters, using at least three of — upper case, lower case, digits, symbols.
#
# The value below is a valid placeholder so a fresh clone starts working immediately. Replace it.
# Generate a strong one:   openssl rand -base64 24
#
# The database is published on 127.0.0.1 only (see docker-compose.yml), so it is never reachable
# from the local network — but this is still a real credential, so treat it as one.
MSSQL_SA_PASSWORD=ChangeThis123!

# Signing key for the JWTs this API issues to its own clients.
#
# This app is entirely self-contained: it signs and validates its own tokens with HMAC-SHA256.
# There is NO Microsoft, Azure AD or Entra ID account involved, and nothing needs registering
# anywhere — any sufficiently long random string works, and it works offline.
#
# The only hard rule: at least 32 characters (256 bits). The API deliberately refuses to start
# below that, because a short key makes the signature brute-forceable (see Program.cs).
#
# Generate a proper one:   openssl rand -base64 48
#
# Changing this value invalidates every token already issued — every user simply logs in again.
JWT_SECRET=change-this-to-a-long-random-string-at-least-32-characters
